/* ------------------- */
/* Reset básico */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, sans-serif;
}

/* ------------------- */
/* Body */
body {
  background-color: #f4f4f4;
  color: #333;
  padding: 20px;
}

/* ------------------- */
/* Títulos */
h1 {
  text-align: center;
  margin-bottom: 20px;
  font-size: 2rem;
}

/* ------------------- */
/* Buscador y autocompletado */
.search-container {
  max-width: 500px;
  margin: 0 auto 20px auto;
  position: relative;
}

#search-input {
  width: 100%;
  padding: 10px;
  font-size: 1rem;
}

.autocomplete-container {
  position: absolute;
  top: 40px;
  width: 100%;
  background: white;
  border: 1px solid #ccc;
  z-index: 100;
  max-height: 200px;
  overflow-y: auto;
}

.autocomplete-item {
  display: flex;
  align-items: center;
  padding: 5px 10px;
  cursor: pointer;
  border-bottom: 1px solid #eee;
}

.autocomplete-item img {
  width: 40px;
  height: 40px;
  margin-right: 10px;
}

/* ------------------- */
/* Filtros */
.filters-container {
  display: flex;
  justify-content: center;
  gap: 10px;
  margin-bottom: 20px;
}

.filter-select {
  padding: 5px 10px;
}

/* ------------------- */
/* Grid de juegos */
.games-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 20px;
}

.game-card {
  background: white;
  padding: 10px;
  border-radius: 8px;
  text-align: center;
  box-shadow: 0 2px 5px rgba(0,0,0,0.1);
  transition: transform 0.2s;
}

.game-card:hover {
  transform: translateY(-5px);
}

.game-card img {
  width: 100%;
  height: auto;
  border-radius: 5px;
  margin-bottom: 10px;
}

.game-card h3 {
  margin-bottom: 5px;
  font-size: 1.1rem;
}

/* ------------------- */
/* Paginación */
.pagination-container {
  display: flex;
  justify-content: center;
  gap: 5px;
  margin-top: 20px;
}

.pagination-container button {
  padding: 5px 10px;
  cursor: pointer;
}

.pagination-container button:disabled {
  background: #ccc;
  cursor: default;
}

/* ------------------- */
/* Detalle del juego */
.detalle-container {
  max-width: 800px;
  margin: 0 auto;
}

.detalle-container img {
  width: 100%;
  max-height: 400px;
  object-fit: cover;
  margin-bottom: 15px;
}

.game-info p {
  margin-bottom: 5px;
}

.game-videos {
  margin-top: 15px;
}

.game-secondary-images {
  display: flex;
  gap: 10px;
  margin-top: 10px;
}

.secondary-img {
  width: 100px;
  height: 100px;
  object-fit: cover;
  border-radius: 5px;
}

/* ------------------- */
/* Ranking */
#ranking-table {
  width: 80%;
  margin: 0 auto 20px auto;
  border-collapse: collapse;
}

#ranking-table th, #ranking-table td {
  border: 1px solid #ccc;
  padding: 8px;
  text-align: center;
}

#ranking-table th {
  background-color: #eee;
}

/* ------------------- */
/* Links */
a {
  text-decoration: none;
  color: #333;
  display: inline-block;
  margin-top: 10px;
}

a:hover {
  color: #007BFF;
}
