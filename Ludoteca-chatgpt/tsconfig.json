{
  "compilerOptions": {
    "target": "es6",
    "module": "ES6",           // <--- CAMBIA ESTO
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "lib": ["es2016", "dom"]
  },
  "include": ["src/**/*"]
}