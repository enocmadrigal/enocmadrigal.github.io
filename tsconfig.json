{
  "compilerOptions": {
    "target": "es6",
    "module": "es6",
    "moduleResolution": "node",
    "outDir": "./",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "lib": ["es2019", "dom"]
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "Ludoteca-chatgpt",
    "Ludoteca-old",
    "node_modules"
  ]
}