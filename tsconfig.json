{
  "compilerOptions": {
    "target": "es6",                // Código JS que se generará
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "lib": ["es2016", "dom"]        // ⚡ IMPORTANTE: agrega es2016
  },
  "include": ["src/**/*"]
}
